      <name>ExtractXML.hpl</name>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>464</xloc>
      <yloc>240</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql>CREATE UNIQUE INDEX lattes_cv_file_key ON hop_stg.lattes_cv (file_key);
ANALYZE hop_stg.lattes_cv;
ANALYZE hop_stg.lattes_node;
CREATE UNLOGGED TABLE hop_stg.lattes_type AS
SELECT node_type, greatest(1, ceil(sum(length(fragment)) / 8000000.0))::int AS buckets
FROM hop_stg.lattes_node GROUP BY node_type;
SET work_mem = '256MB';
CREATE UNLOGGED TABLE hop_stg.lattes_line AS
SELECT n.node_type, abs(hashtext(n.file_key)) % t.buckets AS bucket,
       '&lt;F ' || 'numero_identificador="' || hop_stg.xml_attr(c.numero_identificador) || '"' || ' ' || 'nome_completo="' || hop_stg.xml_attr(c.nome_completo) || '"' || ' ' || 'pais_de_nascimento="' || hop_stg.xml_attr(c.pais_de_nascimento) || '"' || ' ' || 'texto_titulo_jornal_ou_revista="' || hop_stg.xml_attr(c.texto_titulo_jornal_ou_revista) || '"' || ' ' || 'texto_issn="' || hop_stg.xml_attr(c.texto_issn) || '"' || '&gt;' || replace(replace(replace(n.fragment, chr(13), '&amp;#13' || chr(59)), chr(10), '&amp;#10' || chr(59)), chr(9), '&amp;#9' || chr(59)) || '&lt;/F&gt;' AS piece
FROM hop_stg.lattes_node n
JOIN hop_stg.lattes_type t ON t.node_type = n.node_type
LEFT JOIN hop_stg.lattes_cv c ON c.file_key = n.file_key
ORDER BY 1, 2;
RESET work_mem;
DROP TABLE hop_stg.lattes_node;
CREATE INDEX lattes_line_chunk ON hop_stg.lattes_line (node_type, bucket);
ANALYZE hop_stg.lattes_line;
ANALYZE hop_stg.lattes_type;</sql>
