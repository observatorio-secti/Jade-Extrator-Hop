    <action>
      <sql>DROP SCHEMA IF EXISTS hop_stg CASCADE;
CREATE SCHEMA hop_stg;
CREATE UNLOGGED TABLE hop_stg.lattes_node (file_key text NOT NULL, node_type text NOT NULL, fragment text NOT NULL);
CREATE UNLOGGED TABLE hop_stg.lattes_cv (file_key text NOT NULL, numero_identificador text, data_atualizacao text, hora_atualizacao text, nome_completo text, pais_de_nascimento text, texto_titulo_jornal_ou_revista text, texto_issn text, cidade_nascimento text, uf_nascimento text, sigla_pais_nacionalidade text, pais_de_nacionalidade text, orcid_id text, nome_em_citacoes_bibliograficas text, resumo_cv_texto_resumo_cv_rh text, resumo_cv_texto_resumo_cv_rh_en text, outras_informacoes_relevantes_outras_informacoes_relevantes text, endereco_endereco_profissional_nome_instituicao_empresa text);
CREATE FUNCTION hop_stg.xml_attr(t text) RETURNS text LANGUAGE sql IMMUTABLE AS $$ SELECT replace(replace(replace(replace(replace(replace(coalesce(t, ''), chr(38), '&amp;amp' || chr(59)), '&lt;', '&amp;lt' || chr(59)), '"', '&amp;quot' || chr(59)), chr(13), '&amp;#13' || chr(59)), chr(10), '&amp;#10' || chr(59)), chr(9), '&amp;#9' || chr(59)) $$;</sql>
      <connection>ApplicationDB</connection>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>N</sendOneStatement>
      <name>Prepara staging dos XML</name>
      <description/>
      <type>SQL</type>
