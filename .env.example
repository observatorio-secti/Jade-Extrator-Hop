# Nível de log do Apache Hop (Nothing, Error, Minimal, Basic, Detailed, Debug, Rowlevel)
HOP_LOG_LEVEL=Basic

# Credenciais e porta do Hop Server (exposto apenas em 127.0.0.1)
HOP_SERVER_USER=cluster
HOP_SERVER_PASSWORD=changeme
HOP_SERVER_PORT=8080

# URL JDBC do banco PostgreSQL principal (ApplicationDB)
HOP_WRITE_JDBC_URL=jdbc:postgresql://localhost:5432/simcc_write?user=postgres&password=changeme

# Limites de recursos do container Hop
HOP_CPUS=8
HOP_MEM_LIMIT=6g

# Quantidade máxima de execuções persistidas em /files/jade-extrator/logs/executions
HOP_MAX_LOG_EXECUTIONS=200
