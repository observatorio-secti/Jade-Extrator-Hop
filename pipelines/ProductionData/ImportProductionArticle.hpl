  <transform>
    <type>TableInput</type>
    <name>Table bibliographic_production</name>
    <sql>select  
	bp.id, 
	bp.type, 
	bp.title, 
	r.name,
	bp.year, sequence_code
from  bibliographic_production bp
left join researcher r on r.id = bp.researcher_id
left join bibliographic_production_article bpa on bpa.bibliographic_production_id = bp.id
where bp.type = 'ARTICLE' and bpa.id is null</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
