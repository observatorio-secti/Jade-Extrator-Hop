    <sql>SELECT DISTINCT "rank" AS db_rank, journalname AS db_journalname, jcryear AS db_jcryear, issn AS db_issn, eissn AS db_eissn, totalcites AS db_totalcites, '1' AS db_exists FROM "public".jcr</sql>
